<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="LeaveApprovalProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Employee submits leave request">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:serviceTask id="Task_FetchBalance" name="Fetch Leave Balance">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:businessRuleTask id="Task_EvaluateRules" name="Evaluate Leave Rules (DMN)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    
    <bpmn:exclusiveGateway id="Gateway_Routing" name="Routing Decision?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Insuff</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Manager</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask id="Task_NotifyInsufficient" name="Notify Insufficient Balance">
      <bpmn:incoming>Flow_Route_Insuff</bpmn:incoming>
      <bpmn:outgoing>Flow_End_1</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Insufficient" name="Process Ended (Rejected)">
      <bpmn:incoming>Flow_End_1</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:userTask id="Task_ManagerReview" name="Manager Approval">
      <bpmn:incoming>Flow_Route_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager Approved?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manager_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask id="Task_NotifyRejection" name="Notify Rejection">
      <bpmn:incoming>Flow_Manager_No</bpmn:incoming>
      <bpmn:outgoing>Flow_End_2</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Rejected" name="Process Ended (Rejected)">
      <bpmn:incoming>Flow_End_2</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:serviceTask id="Task_UpdateHR" name="Update HR &#38; Deduct Balance">
      <bpmn:incoming>Flow_Route_Auto</bpmn:incoming>
      <bpmn:incoming>Flow_Manager_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:serviceTask id="Task_NotifyApproval" name="Notify Employee of Approval">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_End_3</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_Approved" name="Process Complete">
      <bpmn:incoming>Flow_End_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_FetchBalance" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FetchBalance" targetRef="Task_EvaluateRules" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EvaluateRules" targetRef="Gateway_Routing" />
    
    <bpmn:sequenceFlow id="Flow_Route_Insuff" name="Insufficient Balance" sourceRef="Gateway_Routing" targetRef="Task_NotifyInsufficient" />
    <bpmn:sequenceFlow id="Flow_Route_Manager" name="Manager Review" sourceRef="Gateway_Routing" targetRef="Task_ManagerReview" />
    <bpmn:sequenceFlow id="Flow_Route_Auto" name="Auto-Approve" sourceRef="Gateway_Routing" targetRef="Task_UpdateHR" />
    
    <bpmn:sequenceFlow id="Flow_End_1" sourceRef="Task_NotifyInsufficient" targetRef="EndEvent_Insufficient" />
    
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ManagerReview" targetRef="Gateway_ManagerDecision" />
    
    <bpmn:sequenceFlow id="Flow_Manager_No" name="No" sourceRef="Gateway_ManagerDecision" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_Manager_Yes" name="Yes" sourceRef="Gateway_ManagerDecision" targetRef="Task_UpdateHR" />
    
    <bpmn:sequenceFlow id="Flow_End_2" sourceRef="Task_NotifyRejection" targetRef="EndEvent_Rejected" />
    
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_UpdateHR" targetRef="Task_NotifyApproval" />
    <bpmn:sequenceFlow id="Flow_End_3" sourceRef="Task_NotifyApproval" targetRef="EndEvent_Approved" />
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LeaveApprovalProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchBalance_di" bpmnElement="Task_FetchBalance">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateRules_di" bpmnElement="Task_EvaluateRules">
        <dc:Bounds x="400" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Routing_di" bpmnElement="Gateway_Routing" isMarkerVisible="true">
        <dc:Bounds x="550" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyInsufficient_di" bpmnElement="Task_NotifyInsufficient">
        <dc:Bounds x="650" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Insufficient_di" bpmnElement="EndEvent_Insufficient">
        <dc:Bounds x="800" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerReview_di" bpmnElement="Task_ManagerReview">
        <dc:Bounds x="650" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
        <dc:Bounds x="800" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejection_di" bpmnElement="Task_NotifyRejection">
        <dc:Bounds x="900" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1050" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateHR_di" bpmnElement="Task_UpdateHR">
        <dc:Bounds x="900" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyApproval_di" bpmnElement="Task_NotifyApproval">
        <dc:Bounds x="1050" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1200" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="400" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="500" y="220" />
        <di:waypoint x="550" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Insuff_di" bpmnElement="Flow_Route_Insuff">
        <di:waypoint x="575" y="195" />
        <di:waypoint x="575" y="120" />
        <di:waypoint x="650" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Manager_di" bpmnElement="Flow_Route_Manager">
        <di:waypoint x="600" y="220" />
        <di:waypoint x="650" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Auto_di" bpmnElement="Flow_Route_Auto">
        <di:waypoint x="575" y="245" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="900" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End_1_di" bpmnElement="Flow_End_1">
        <di:waypoint x="750" y="120" />
        <di:waypoint x="800" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="750" y="220" />
        <di:waypoint x="800" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_No_di" bpmnElement="Flow_Manager_No">
        <di:waypoint x="825" y="195" />
        <di:waypoint x="825" y="120" />
        <di:waypoint x="900" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Yes_di" bpmnElement="Flow_Manager_Yes">
        <di:waypoint x="825" y="245" />
        <di:waypoint x="825" y="340" />
        <di:waypoint x="900" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End_2_di" bpmnElement="Flow_End_2">
        <di:waypoint x="1000" y="120" />
        <di:waypoint x="1050" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1000" y="340" />
        <di:waypoint x="1050" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End_3_di" bpmnElement="Flow_End_3">
        <di:waypoint x="1150" y="340" />
        <di:waypoint x="1200" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>